---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import SocialLinks from "../components/SocialLinks.astro";
import { legalPlaceholders, whatsappDisplay, whatsappUrl } from "../config/site";
---

<Layout title="Contacto" description="Contactá a Casa Shirley por WhatsApp, email o redes sociales.">
  <PageHero
    eyebrow="Contacto"
    title="Hablemos de tu proyecto"
    description="Presupuestos, consultas técnicas e inscripción a la academia. Preferimos WhatsApp para respuesta ágil."
  />

  <section class="section-padding">
    <div class="container-narrow grid gap-10 lg:grid-cols-2">
      <div class="space-y-6">
        <a href={whatsappUrl()} class="btn-whatsapp w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
          WhatsApp {whatsappDisplay}
        </a>
        <p class="text-muted">
          Email: <a href={`mailto:${legalPlaceholders.email}`} class="font-medium text-brand-600 hover:underline">{legalPlaceholders.email}</a>
        </p>
        <div>
          <p class="font-semibold text-ink">Seguinos</p>
          <div class="mt-3">
            <SocialLinks variant="onLight" />
          </div>
        </div>
        <div class="rounded-2xl border border-dashed border-border bg-surface p-6 text-sm text-muted">
          <p class="font-semibold text-ink">Ubicación</p>
          <p class="mt-2">{legalPlaceholders.domicilioComercial}</p>
          <p class="mt-4">Mapa interactivo — [Por confirmar en versión final]</p>
        </div>
      </div>

      <form
        id="contact-form"
        class="rounded-2xl border border-border bg-white p-8 shadow-sm space-y-4"
      >
        <h2 class="text-lg font-bold text-ink">Formulario de consulta</h2>
        <p class="text-xs text-muted">Demo: no envía email. En producción se conectará al correo del cliente.</p>
        <label class="block text-sm">
          <span class="font-medium">Nombre</span>
          <input required name="nombre" class="mt-1 w-full rounded-lg border border-border px-3 py-2" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Email</span>
          <input required type="email" name="email" class="mt-1 w-full rounded-lg border border-border px-3 py-2" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Teléfono</span>
          <input name="telefono" class="mt-1 w-full rounded-lg border border-border px-3 py-2" />
        </label>
        <label class="block text-sm">
          <span class="font-medium">Mensaje</span>
          <textarea required name="mensaje" rows="4" class="mt-1 w-full rounded-lg border border-border px-3 py-2"></textarea>
        </label>
        <button type="submit" class="btn-primary w-full">Enviar consulta</button>
      </form>
    </div>
  </section>
</Layout>

<script>
  document.getElementById("contact-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    alert("Gracias por tu mensaje. En la versión final esta consulta se enviará por email. Por ahora, escribinos por WhatsApp.");
  });
</script>
