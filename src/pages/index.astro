---
import Layout from "@/layouts/Layout.astro";
import BrandStrip from "@/components/catalog/BrandStrip.astro";
import ProductCard from "@/components/catalog/ProductCard.astro";
import BudgetWhatsAppForm from "@/components/BudgetWhatsAppForm.astro";
import { getFeaturedProducts } from "@/lib/catalog";
import { site, academyName } from "@/config";

const featured = await getFeaturedProducts(6);
---

<Layout title={site.name} description={site.description}>
  <section class="relative min-h-[88vh] flex items-center justify-start overflow-hidden border-b border-border">
    <img
      src="/images/hero/hero-casa-shirley-cool.jpg"
      alt=""
      class="hero-bg-image absolute inset-0 h-full w-full object-cover object-[70%_center] sm:object-center"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-r from-slate-950/95 via-slate-900/80 to-slate-900/20 sm:via-slate-900/70 sm:to-slate-800/10"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-gradient-to-br from-brand-900/25 via-transparent to-sky-950/30 mix-blend-multiply"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-slate-950/50 via-transparent to-slate-900/25" aria-hidden="true" />

    <div class="container-narrow relative z-10 w-full px-4 py-16 text-left sm:px-6 sm:py-20 lg:px-8 lg:py-24">
      <div class="max-w-xl lg:max-w-2xl w-full mr-auto text-left">
        <p class="inline-flex rounded-full bg-white/15 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-white backdrop-blur-sm ring-1 ring-white/20">
          Importadores directos · Argentina
        </p>
        <h1 class="mt-6 text-4xl font-bold leading-[1.08] tracking-tight text-white sm:text-5xl lg:text-[3.25rem]">
          Importador de máquinas de coser industriales
        </h1>
        <p class="mt-5 max-w-lg text-base leading-relaxed text-white/85 sm:text-lg">
          Equipos, repuestos y accesorios con asesoramiento comercial.
          Formación con <span class="font-semibold text-white">{academyName}</span>.
        </p>
        <div class="mt-9 flex flex-col items-start gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-start">
          <a href="/maquinas" class="btn-primary px-8 py-3.5 text-base shadow-lg">
            Conocé nuestras máquinas
          </a>
          <a href="/academia" class="btn-academy bg-white/95 border-white/40 hover:bg-white shadow-lg">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-brand-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
            {academyName}
          </a>
        </div>
        <ul class="mt-10 grid gap-3 sm:grid-cols-3 text-sm text-white/90 text-left">
          <li class="flex items-start gap-2 rounded-xl bg-white/10 px-3 py-3 backdrop-blur-sm ring-1 ring-white/15">
            <span class="text-sky-200 font-bold">✓</span>
            <span>Venta mayor y menor</span>
          </li>
          <li class="flex items-start gap-2 rounded-xl bg-white/10 px-3 py-3 backdrop-blur-sm ring-1 ring-white/15">
            <span class="text-sky-200 font-bold">✓</span>
            <span>Marcas líderes</span>
          </li>
          <li class="flex items-start gap-2 rounded-xl bg-white/10 px-3 py-3 backdrop-blur-sm ring-1 ring-white/15 sm:col-span-1 col-span-full">
            <span class="text-sky-200 font-bold">✓</span>
            <span>Importación directa desde China</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <BrandStrip />

  <section class="section-padding">
    <div class="container-narrow">
      <div class="grid gap-8 md:grid-cols-2">
        <article class="rounded-3xl border border-border bg-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink">Maquinaria y repuestos</h2>
          <p class="mt-3 text-muted leading-relaxed">
            Overlocks, collaretas, botoneras, cortadoras y accesorios de marcas líderes.
            Consultá stock y presupuesto por WhatsApp con nuestro equipo comercial.
          </p>
          <a href="/maquinas" class="btn-primary mt-6 inline-flex">Ver máquinas</a>
        </article>
        <article class="rounded-3xl border border-brand-200 bg-gradient-to-br from-brand-50 to-white p-8 shadow-sm">
          <h2 class="text-2xl font-bold text-ink">{academyName}</h2>
          <p class="mt-3 text-muted leading-relaxed">
            Formación orientada a quienes quieren entender el camino real de una importación:
            proveedores, logística, costos y gestión en Argentina.
          </p>
          <a href="/academia/inscripcion" class="btn-academy mt-6 inline-flex">Solicitar inscripción</a>
        </article>
      </div>
    </div>
  </section>

  <section class="border-y border-border bg-white section-padding">
    <div class="container-narrow">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold text-ink sm:text-3xl">Equipos destacados</h2>
          <p class="mt-2 text-muted">Consultá disponibilidad y configuración.</p>
        </div>
        <a href="/maquinas" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Ver todas →</a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <section class="section-padding" id="presupuesto">
    <div class="container-narrow rounded-3xl bg-ink px-6 py-12 sm:px-10 lg:px-14 lg:py-16">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
        <div class="text-center lg:text-left">
          <h2 class="text-2xl font-bold text-white sm:text-3xl lg:text-4xl leading-tight">
            ¿Listo para armar tu presupuesto?
          </h2>
          <p class="mt-4 text-white/75 leading-relaxed max-w-md mx-auto lg:mx-0">
            Completá el formulario y se abrirá WhatsApp con tu consulta lista para enviar.
            Un asesor comercial te responderá a la brevedad.
          </p>
        </div>
        <BudgetWhatsAppForm />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-bg-image {
    filter: saturate(0.85) brightness(0.94) contrast(1.04);
  }
</style>
