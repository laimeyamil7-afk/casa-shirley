---
import "@/styles/global.css";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFab from "@/components/WhatsAppFab.astro";
import CartRuntime from "@/components/commerce/CartRuntime.astro";
import { site, features } from "@/config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = site.name,
  description = site.description,
} = Astro.props;

const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {features.demoMode && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/jpeg" href="/images/logo-casa-shirley.jpg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/logo-casa-shirley.jpg" />
    <meta property="og:type" content="website" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppFab />
    <CartRuntime />
  </body>
</html>
