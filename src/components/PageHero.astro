---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="border-b border-border bg-gradient-to-br from-brand-50 via-surface to-white">
  <div class="container-narrow section-padding">
    {eyebrow && (
      <p class="text-sm font-semibold uppercase tracking-widest text-brand-600">{eyebrow}</p>
    )}
    <h1 class="mt-2 max-w-3xl text-3xl font-bold tracking-tight text-ink sm:text-4xl lg:text-5xl">
      {title}
    </h1>
    {description && (
      <p class="prose-narrow mt-4 text-lg">{description}</p>
    )}
    <slot />
  </div>
</section>
