---
import { navLinks, site } from "@/config/site";
import CartIcon from "@/components/commerce/CartIcon.astro";

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-border bg-white shadow-sm">
  <div class="container-narrow flex items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8 lg:py-5">
    <a href="/" class="flex items-center gap-4 min-w-0 shrink-0">
      <img
        src="/images/logo-casa-shirley.jpg"
        alt={site.name}
        width="56"
        height="56"
        class="h-14 w-14 rounded-full object-cover ring-2 ring-brand-100 sm:h-16 sm:w-16"
      />
      <span class="font-bold text-lg text-ink sm:text-xl tracking-tight">{site.name}</span>
    </a>

    <nav class="hidden lg:flex items-center justify-center flex-1 gap-0.5" aria-label="Principal">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-lg px-5 py-2.5 text-[15px] font-semibold tracking-wide transition",
              currentPath === link.href ||
              (link.href !== "/" && currentPath.startsWith(link.href))
                ? "bg-brand-600 text-white"
                : "text-ink/80 hover:bg-brand-50 hover:text-brand-800",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 shrink-0">
      <CartIcon />
      <button
        type="button"
        id="menu-toggle"
        class="lg:hidden inline-flex h-12 w-12 items-center justify-center rounded-lg border border-border text-ink hover:bg-surface"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden lg:hidden border-t border-border bg-white px-4 py-4">
    <nav class="flex flex-col gap-1" aria-label="Móvil">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-lg px-4 py-3.5 text-base font-semibold text-ink hover:bg-brand-50"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
