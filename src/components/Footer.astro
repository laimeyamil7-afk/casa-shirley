---
import SocialLinks from "./SocialLinks.astro";
import { legalPlaceholders, navLinks, site, whatsappDisplay, whatsappUrl } from "../config/site";
---

<footer class="border-t border-border bg-ink text-white">
  <div class="container-narrow section-padding grid gap-10 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-bold text-lg">{site.name}</p>
      <p class="mt-2 text-sm text-white/70 leading-relaxed">{site.tagline}</p>
    </div>
    <div>
      <p class="font-semibold text-sm uppercase tracking-wide text-white/50">Navegación</p>
      <ul class="mt-4 space-y-2 text-sm">
        {navLinks.map((l) => (
          <li><a href={l.href} class="text-white/80 hover:text-white">{l.label}</a></li>
        ))}
        <li><a href="/mayoristas" class="text-white/80 hover:text-white">Mayoristas</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold text-sm uppercase tracking-wide text-white/50">Contacto</p>
      <ul class="mt-4 space-y-2 text-sm text-white/80">
        <li>
          <a href={whatsappUrl()} class="hover:text-white">WhatsApp {whatsappDisplay}</a>
        </li>
        <li>
          <a href={`mailto:${legalPlaceholders.email}`} class="hover:text-white">{legalPlaceholders.email}</a>
        </li>
      </ul>
      <p class="mt-4 font-semibold text-sm uppercase tracking-wide text-white/50">Redes</p>
      <div class="mt-3">
        <SocialLinks variant="onDark" />
      </div>
    </div>
    <div>
      <p class="font-semibold text-sm uppercase tracking-wide text-white/50">Legal</p>
      <p class="mt-4 text-xs text-white/60 leading-relaxed">
        {legalPlaceholders.razonSocial}<br />
        CUIT {legalPlaceholders.cuit}
      </p>
      <a href="/privacidad" class="mt-3 inline-block text-sm text-white/70 hover:text-white">Privacidad</a>
    </div>
  </div>
  <div class="border-t border-white/10 py-6 text-center text-xs text-white/50">
    © {new Date().getFullYear()} {site.name}. Demo — datos sujetos a confirmación.
  </div>
</footer>
